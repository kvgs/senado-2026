dados/_matriz_derivada.json

# Lixo de sistema
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc

# textos extraidos dos PDFs (recriaveis com pdftotext)
fontes/*.txt

# Dataset consulta_cand do TSE: contem CPF e titulo eleitoral de todos os
# candidatos do pais. Publico na origem NAO autoriza republicacao — e a
# agregacao num repositorio publico e justamente o que facilita o mau uso.
# Fica so na maquina; documentos.json guarda URL, bytes e sha256 para quem
# quiser reproduzir. O de redes sociais nao tem coluna sensivel e pode ficar.
fontes/consulta-candidatos-2026.zip

# Prestacao de contas do TSE: CPF e nome de doador pessoa fisica em milhares de
# linhas, alem de CPF de candidato. Mesma regra do consulta_cand — publico na
# origem nao autoriza republicacao, e agregar doador individual num repositorio
# publico e o que facilita o mau uso. Fica local; documentos.json guarda URL e
# sha256 para reproduzir.
fontes/prestacao-contas-2026.zip

# Copia de seguranca que revisar.py faz ao iniciar; o git ja e o historico
# Copia que revisar.py faz antes da primeira decisao. O caminho aqui era
# dados/posicoes.json.antes-da-revisao, do tempo em que o acervo tinha um
# estado so — e parou de casar quando virou dados/<uf>/, sem avisar. A regra
# continuou no arquivo parecendo que funcionava.
dados/*/posicoes.json.antes-da-revisao
dados/posicoes.json.antes-da-revisao

# Apelido de quem revisa nesta maquina. Escolhido pela pessoa, nao herdado do
# git config: ali esta o nome civil, e este repositorio e publico.
.quem
fontes-ttf/

# Documento politico-programatico do MDB (Caminhos para o Brasil, 2025): 51 MB
# de PDF diagramado. Grande demais para o repositorio, e recriavel — a URL, o
# tamanho e o sha256 ficam em documentos.json, que e o que prova que o arquivo
# baixado hoje e o mesmo que foi lido.
fontes/programa-mdb-2025-caminhos-para-o-brasil.pdf
